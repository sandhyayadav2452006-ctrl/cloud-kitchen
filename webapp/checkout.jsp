<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout | TasteNest</title><link rel="stylesheet" href="css/site.css"></head><body><header class="top"><div class="nav"><a class="logo" href="index.jsp">TasteNest<small>CHECKOUT</small></a><nav class="links"><a href="menu.jsp">Menu</a><a href="cart.jsp">Back to Cart</a></nav></div></header><main class="container"><div class="panel auth"><div class="section-title"><div class="eyebrow">CUSTOMER</div><h1>Checkout</h1><p class="muted">Enter delivery details and choose a payment method.</p></div><form class="form" onsubmit="placeOrder(event)"><label>Full Name</label><input name="name" required><label>Mobile Number</label><input name="mobile" required><label>Delivery Address</label><textarea name="address" required></textarea><label>Payment Method</label><select name="payment"><option>UPI</option><option>Card</option><option>COD</option></select><button class="btn">Place Order</button></form></div></main><script src="js/site.js"></script></body></html>
