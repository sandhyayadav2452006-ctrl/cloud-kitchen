<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Feedback | TasteNest</title><link rel="stylesheet" href="css/site.css"></head><body><header class="top"><div class="nav"><a class="logo" href="customer-home.jsp">TasteNest<small>FEEDBACK</small></a><nav class="links"><a href="my-orders.jsp">My Orders</a><a href="menu.jsp">Menu</a></nav></div></header><main class="container"><div class="panel auth"><div class="section-title"><div class="eyebrow">CUSTOMER</div><h1>Order Feedback</h1></div><form class="form" onsubmit="submitFeedback(event)"><label>Order ID</label><input name="orderId" placeholder="e.g. 1" required><label>Rating</label><select name="rating"><option value="5">5 - Excellent</option><option value="4">4 - Good</option><option value="3">3 - Average</option><option value="2">2 - Needs improvement</option><option value="1">1 - Poor</option></select><label>Comment</label><textarea name="comment" placeholder="Tell us about your order"></textarea><button class="btn">Submit Feedback</button></form><p id="feedbackMsg" class="notice"></p></div></main><script src="js/site.js"></script></body></html>
