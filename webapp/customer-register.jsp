<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Customer Register | TasteNest</title><link rel="stylesheet" href="css/site.css"></head><body><header class="top"><div class="nav"><a class="logo" href="index.jsp">TasteNest<small>CLOUD KITCHEN</small></a><nav class="links"><a href="customer-login.jsp">Customer Login</a><a href="menu.jsp">Menu</a></nav></div></header><main class="container"><div class="panel auth"><div class="section-title"><div class="eyebrow">CUSTOMER ACCOUNT</div><h1>Create Account</h1></div><form class="form" onsubmit="registerCustomer(event)"><label>Full Name</label><input name="name" required><label>Mobile Number</label><input name="mobile" required><label>Email</label><input name="email" type="text" required><label>Password</label><input name="password" type="password" required><label>Confirm Password</label><input name="confirm" type="password" required><button class="btn">Create Account</button></form><p id="regMsg" class="notice"></p></div></main><script src="js/site.js"></script></body></html>
